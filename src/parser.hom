// parser.hom — Recursive-descent Pratt parser → AST
//
// Uses:
//   parser_imp — ps_peek_token, ps_same_line, AST constructors,
//                Option helpers, split_block
//
// Thread-local state (pos, err, gensym_counter) lives here as @thread_local
// bindings; the thin wrappers (ps_advance, ps_save, …) are defined below.
// PARSE_TOKENS stays in parser_imp.rs (concrete Vec<Token> type required).
//
// Public API:
//   parse_program() -> @[Stmt]     — called from parser.rs wrapper

// ─── Thread-local parser state ───────────────────────────────────────────────

@thread_local
parse_pos ::= 0

@thread_local
parse_err ::= ""

@thread_local
gensym_counter ::= 0

// ─── State accessor wrappers ─────────────────────────────────────────────────

ps_pos := () -> int { parse_pos }

ps_advance := () -> _ {
  if (parse_err == "") { parse_pos ::= parse_pos + 1 }
}

ps_save := () -> int { parse_pos }

ps_restore := (p: int) -> _ { parse_pos ::= p }

ps_has_err := () -> bool { parse_err != "" }

ps_set_err := (msg: str) -> _ {
  if (parse_err == "") { parse_err ::= msg }
}

ps_gensym := (prefix: str) -> str {
  n := gensym_counter
  gensym_counter ::= gensym_counter + 1
  "${prefix}${n}"
}

use parser_imp

// ─── Token inspection (migrated from parser_imp.rs) ─────────────────────────

ps_peek_kind := () -> str {
  if (ps_has_err()) { "Eof" }
  else {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Int(_) -> "Int"
    TokenKind.Float(_) -> "Float"
    TokenKind.Bool(_) -> "Bool"
    TokenKind.Str(_) -> "Str"
    TokenKind.Char(_) -> "Char"
    TokenKind.None -> "None"
    TokenKind.Ident(_) -> "Ident"
    TokenKind.Use -> "Use"
    TokenKind.Struct -> "Struct"
    TokenKind.Enum -> "Enum"
    TokenKind.For -> "For"
    TokenKind.In -> "In"
    TokenKind.While -> "While"
    TokenKind.Do -> "Do"
    TokenKind.If -> "If"
    TokenKind.Else -> "Else"
    TokenKind.Match -> "Match"
    TokenKind.Break -> "Break"
    TokenKind.Continue -> "Continue"
    TokenKind.And -> "And"
    TokenKind.Or -> "Or"
    TokenKind.Not -> "Not"
    TokenKind.As -> "As"
    TokenKind.Rec -> "Rec"
    TokenKind.MutAssign -> "MutAssign"
    TokenKind.DoubleColon -> "DoubleColon"
    TokenKind.Assign -> "Assign"
    TokenKind.Arrow -> "Arrow"
    TokenKind.FatArrow -> "FatArrow"
    TokenKind.Pipe -> "Pipe"
    TokenKind.Dot -> "Dot"
    TokenKind.Plus -> "Plus"
    TokenKind.Minus -> "Minus"
    TokenKind.Star -> "Star"
    TokenKind.Slash -> "Slash"
    TokenKind.Percent -> "Percent"
    TokenKind.Eq -> "Eq"
    TokenKind.Neq -> "Neq"
    TokenKind.Lt -> "Lt"
    TokenKind.Gt -> "Gt"
    TokenKind.Le -> "Le"
    TokenKind.Ge -> "Ge"
    TokenKind.Colon -> "Colon"
    TokenKind.Comma -> "Comma"
    TokenKind.Semi -> "Semi"
    TokenKind.Underscore -> "Underscore"
    TokenKind.At -> "At"
    TokenKind.Bang -> "Bang"
    TokenKind.Question -> "Question"
    TokenKind.LParen -> "LParen"
    TokenKind.RParen -> "RParen"
    TokenKind.LBrace -> "LBrace"
    TokenKind.RBrace -> "RBrace"
    TokenKind.LBracket -> "LBracket"
    TokenKind.RBracket -> "RBracket"
    TokenKind.Eof -> "Eof"
  }
  }
}

ps_peek_ident := () -> str {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Ident(n) -> n
    _ -> ""
  }
}

ps_peek_int := () -> i64 {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Int(n) -> to_i64(n)
    _ -> 0
  }
}

ps_peek_float := () -> f64 {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Float(f) -> to_f64(f)
    _ -> to_f64(0.0)
  }
}

ps_peek_bool := () -> bool {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Bool(b) -> b
    _ -> false
  }
}

ps_peek_str := () -> str {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Str(s) -> s
    _ -> ""
  }
}

ps_peek_char := () -> str {
  t := ps_peek_token()
  match t.kind {
    TokenKind.Char(c) -> str(c)
    _ -> ""
  }
}

// ─── Token matching (migrated from parser_imp.rs) ──────────────────────────

ps_check := (kind: str) -> bool {
  if (ps_has_err()) { => false }
  ps_peek_kind() == kind
}

ps_consume := (kind: str) -> bool {
  if (ps_has_err()) { => false }
  if (ps_peek_kind() == kind) {
    ps_advance()
    true
  } else {
    false
  }
}

ps_expect := (kind: str) -> _ {
  if (not ps_has_err()) {
    actual := ps_peek_kind()
    if (actual == kind) {
      ps_advance()
    } else {
      ps_set_err("Expected ${kind} but got ${actual}")
    }
  }
}

ps_advance_ident := () -> str {
  if (ps_has_err()) { "" }
  else {
    t := ps_peek_token()
    match t.kind {
      TokenKind.Ident(n) -> {
        ps_advance()
        n
      }
      _ -> {
        ps_set_err("Expected identifier, got ${ps_peek_kind()}")
        ""
      }
    }
  }
}

// ─── Attribute helpers (migrated from parser_imp.rs) ────────────────────────

token_to_body_str := (t: Token) -> str {
  match t.kind {
    TokenKind.Ident(s) -> s
    TokenKind.Int(n) -> str(n)
    TokenKind.Float(f) -> str(f)
    TokenKind.Bool(b) -> str(b)
    TokenKind.Str(s) -> "\"" + s + "\""
    TokenKind.Char(c) -> "'" + str(c) + "'"
    TokenKind.LParen -> "("
    TokenKind.RParen -> ")"
    TokenKind.LBrace -> "{"
    TokenKind.RBrace -> "}"
    TokenKind.LBracket -> "["
    TokenKind.RBracket -> "]"
    TokenKind.Comma -> ","
    TokenKind.Dot -> "."
    TokenKind.Colon -> ":"
    TokenKind.DoubleColon -> "::"
    TokenKind.Semi -> ";"
    TokenKind.Underscore -> "_"
    TokenKind.Plus -> "+"
    TokenKind.Minus -> "-"
    TokenKind.Star -> "*"
    TokenKind.Slash -> "/"
    TokenKind.Percent -> "%"
    TokenKind.Eq -> "=="
    TokenKind.Neq -> "!="
    TokenKind.Lt -> "<"
    TokenKind.Gt -> ">"
    TokenKind.Le -> "<="
    TokenKind.Ge -> ">="
    TokenKind.Pipe -> "|"
    TokenKind.At -> "@"
    TokenKind.Bang -> "!"
    TokenKind.Question -> "?"
    _ -> ""
  }
}

ps_collect_attr_body := () -> str {
  if (ps_has_err()) { "" }
  else {
    t := ps_peek_token()
    attr_line := t.pos.line
    ps_advance()
    parts ::= @[]
    done ::= false
    while (not done) {
      if (ps_has_err()) { done ::= true }
      else {
        t2 := ps_peek_token()
        if (t2.pos.line != attr_line) { done ::= true }
        else {
          match t2.kind {
            TokenKind.Eof -> { done ::= true }
            _ -> {
              push(parts, token_to_body_str(t2))
              ps_advance()
            }
          }
        }
      }
    }
    join(parts, "")
  }
}

ps_collect_outer_attr_body := () -> str {
  if (ps_has_err()) { "" }
  else {
    parts ::= @[]
    t := ps_peek_token()
    attr_line := t.pos.line
    name := match t.kind {
      TokenKind.Ident(n) -> n
      _ -> ""
    }
    if (name == "") { "" }
    else {
      push(parts, name)
      ps_advance()
      t2 := ps_peek_token()
      if (t2.pos.line == attr_line) {
        k := ps_peek_kind()
        if (k == "LParen" or k == "LBracket" or k == "LBrace") {
          push(parts, token_to_body_str(t2))
          ps_advance()
          depth ::= 1
          while (depth > 0) {
            if (ps_has_err()) { break }
            t3 := ps_peek_token()
            k3 := ps_peek_kind()
            if (k3 == "Eof") { break }
            if (k3 == "LParen" or k3 == "LBracket" or k3 == "LBrace") {
              depth ::= depth + 1
              push(parts, token_to_body_str(t3))
              ps_advance()
            } else {
              if (k3 == "RParen" or k3 == "RBracket" or k3 == "RBrace") {
                depth ::= depth - 1
                push(parts, token_to_body_str(t3))
                ps_advance()
              } else {
                push(parts, token_to_body_str(t3))
                ps_advance()
              }
            }
          }
        }
      }
      join(parts, "")
    }
  }
}

// ─── Block / pair utilities (migrated from parser_imp.rs) ──────────────────

split_block := (stmts: @[Stmt]) -> (@[Stmt], Expr) {
  if (len(stmts) == 0) {
    empty := @[]
    => (stmts, Expr.Tuple(empty))
  }
  last := stmts[len(stmts) - 1]
  match last {
    Stmt.Expression(e) -> {
      init := stmts[:-1]
      (init, e)
    }
    _ -> {
      empty := @[]
      (stmts, Expr.Tuple(empty))
    }
  }
}

expr_to_lvalue := (e: Expr) -> LValue {
  match e {
    Expr.Var(n) -> LValue.Var(n)
    Expr.Field(base, name) -> LValue.Field(expr_to_lvalue(base), name)
    Expr.Index(base, idx) -> LValue.Index(expr_to_lvalue(base), idx)
    _ -> LValue.Var("_")
  }
}

push_name_expr_pair := (pairs: @[(str, Expr)], name: str, expr: Expr) -> @[(str, Expr)] {
  push(pairs, (name, expr))
  pairs
}

push_expr_pair := (pairs: @[(Expr, Expr)], k: Expr, v: Expr) -> @[(Expr, Expr)] {
  push(pairs, (k, v))
  pairs
}

new_name_expr_pairs := () -> @[(str, Expr)] { @[] }

new_expr_pairs := () -> @[(Expr, Expr)] { @[] }

// ─── Entry point ────────────────────────────────────────────────────────────

parse_program := () -> @[Stmt] {
  stmts ::= @[]
  done ::= false
  at_top ::= true
  while (not done) {
    k := ps_peek_kind()
    if (k == "Eof" or k == "RBrace") {
      done ::= true
    } else {
      if (k == "At" and ps_peek_next_kind() == "Bang") {
        if (at_top) {
          ps_advance()
          body := ps_collect_attr_body()
          push(stmts, Stmt.InnerAttr(body))
        } else {
          ps_set_err("@! inner attribute must appear before any declarations")
          done ::= true
        }
      } else {
        if (k == "At" and ps_peek_next_kind() == "Ident") {
          // Collect one or more outer attrs: @ident...
          outer_attrs ::= @[]
          while (ps_check("At") and ps_peek_next_kind() == "Ident") {
            ps_advance()
            body := ps_collect_outer_attr_body()
            outer_attrs ::= outer_attrs + @[body]
          }
          // Expect a decl-starter after attrs
          k2 := ps_peek_kind()
          if (k2 == "Ident") {
            at_top ::= false
            push(stmts, parse_top_bind_attrs(outer_attrs))
          } else {
            ps_set_err("attribute must precede a struct, enum, or top-level binding")
            done ::= true
          }
        } else {
          if (k == "Use") {
            at_top ::= false
            push(stmts, parse_use())
          } else {
            if (k == "Ident") {
              at_top ::= false
              push(stmts, parse_top_bind())
            } else {
              done ::= true
            }
          }
        }
      }
    }
  }
  ps_expect("Eof")
  stmts
}

// ─── Top-level statements ───────────────────────────────────────────────────

parse_use := () -> Stmt {
  ps_expect("Use")
  path := parse_mod_path()
  Stmt.Use(path)
}

// Collect a balanced `{...}` group verbatim, for Rust pass-through paths such
// as `use engine::{Transform, Vec3}`. Homun never interprets the contents.
parse_brace_group := () -> str {
  ps_expect("LBrace")
  // Start empty and push, so every element is an owned String.
  parts ::= @[]
  push(parts, "{")
  depth ::= 1
  done ::= false
  while (not done) {
    if (ps_has_err()) {
      done ::= true
    } else {
      t := ps_peek_token()
      k := ps_peek_kind()
      if (k == "Eof") {
        done ::= true
      } else {
        if (k == "LBrace") {
          depth ::= depth + 1
          push(parts, "{")
          ps_advance()
        } else {
          if (k == "RBrace") {
            depth ::= depth - 1
            push(parts, "}")
            ps_advance()
            if (depth == 0) { done ::= true }
          } else {
            push(parts, token_to_body_str(t))
            ps_advance()
          }
        }
      }
    }
  }
  join(parts, "")
}

parse_mod_path := () -> @[str] {
  name := ps_advance_ident()
  if (ps_has_err()) {
    => @[]
  }
  if (ps_consume("DoubleColon")) {
    nk := ps_peek_kind()
    if (nk == "LBrace") {
      // `use a::{B, C}` — a Rust path, passed through untouched.
      @[name] + @[parse_brace_group()]
    } else {
      if (nk == "Star") {
        ps_advance()
        glob ::= @[]
        push(glob, "*")
        @[name] + glob
      } else {
        rest := parse_mod_path()
        @[name] + rest
      }
    }
  } else {
    @[name]
  }
}

parse_top_bind := () -> Stmt {
  name := ps_advance_ident()
  ps_expect("Assign")
  k := ps_peek_kind()
  if (k == "Struct") {
    ps_advance()
    fields ::= parse_brace_fields()
    Stmt.StructDef(name, fields, @[])
  } else {
    if (k == "Enum") {
      ps_advance()
      variants ::= parse_brace_variants()
      Stmt.EnumDef(name, variants, @[])
    } else {
      rhs := parse_expr()
      Stmt.Bind(name, rhs, @[])
    }
  }
}

parse_top_bind_attrs := (attrs: @[str]) -> Stmt {
  name := ps_advance_ident()
  // @thread_local name ::= expr  →  Stmt::ThreadLocal
  if ("thread_local" in attrs) {
    ps_expect("MutAssign")
    rhs := parse_expr()
    => Stmt.ThreadLocal(name, rhs)
  }
  ps_expect("Assign")
  k := ps_peek_kind()
  if (k == "Struct") {
    ps_advance()
    fields ::= parse_brace_fields()
    Stmt.StructDef(name, fields, attrs)
  } else {
    if (k == "Enum") {
      ps_advance()
      variants ::= parse_brace_variants()
      Stmt.EnumDef(name, variants, attrs)
    } else {
      rhs := parse_expr()
      Stmt.Bind(name, rhs, attrs)
    }
  }
}

parse_brace_fields := () -> @[FieldDef] {
  ps_expect("LBrace")
  fields ::= @[]
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "RBrace") {
      done ::= true
    } else {
      if (k == "Ident") {
        name := ps_peek_ident()
        ps_advance()
        ps_expect("Colon")
        ty := parse_type_expr()
        ps_consume("Comma")
        push(fields, FieldDef { name: name, ty: Some(ty) })
      } else {
        done ::= true
      }
    }
  }
  ps_expect("RBrace")
  fields
}

parse_brace_variants := () -> @[VariantDef] {
  ps_expect("LBrace")
  variants ::= @[]
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "RBrace") {
      done ::= true
    } else {
      if (k == "Ident") {
        name := ps_peek_ident()
        ps_advance()
        if (ps_check("LParen")) {
          ps_advance()
          // Named fields: Variant(field: Type, ...) — ident followed by colon
          is_named := ps_peek_kind() == "Ident" and ps_peek_next_kind() == "Colon"
          if (is_named) {
            fnames ::= @[]
            ftys ::= @[]
            fname := ps_advance_ident()
            ps_expect("Colon")
            fty := parse_type_expr()
            push(fnames, fname)
            push(ftys, fty)
            while (ps_consume("Comma")) {
              if (ps_check("RParen")) { break }
              fname2 := ps_advance_ident()
              ps_expect("Colon")
              fty2 := parse_type_expr()
              push(fnames, fname2)
              push(ftys, fty2)
            }
            ps_expect("RParen")
            ps_consume("Comma")
            push(variants, mk_variantdef_multi(name, fnames, ftys))
          } else {
            // Positional fields (single or multi)
            all_tys ::= @[parse_type_expr()]
            while (ps_consume("Comma")) {
              if (ps_check("RParen")) { break }
              push(all_tys, parse_type_expr())
            }
            ps_expect("RParen")
            ps_consume("Comma")
            if (len(all_tys) == 1) {
              push(variants, VariantDef { name: name, fields: @[(none, all_tys[0])] })
            } else {
              push(variants, mk_variantdef_positional(name, all_tys))
            }
          }
        } else {
          ps_consume("Comma")
          push(variants, VariantDef { name: name, fields: @[] })
        }
      } else {
        done ::= true
      }
    }
  }
  ps_expect("RBrace")
  variants
}

// ─── Block statements ───────────────────────────────────────────────────────

parse_block_stmts := () -> @[Stmt] {
  stmts ::= @[]
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "RBrace" or k == "Eof") {
      done ::= true
    } else {
      if (k == "FatArrow") {
        ps_advance()
        e := parse_expr()
        push(stmts, Stmt.Expression(Expr.EarlyReturn(e)))
      } else {
        if (k == "LBrace") {
          // Try struct destructure: {x: a, y: b} := expr
          sd_stmts := try_parse_struct_destruct()
          if (len(sd_stmts) > 0) {
            si ::= 0
            while (si < len(sd_stmts)) {
              push(stmts, sd_stmts[si])
              si ::= si + 1
            }
          } else {
            e := parse_expr()
            push(stmts, Stmt.Expression(e))
          }
        } else {
          if (k == "Ident") {
            push(stmts, parse_block_bind())
          } else {
            e := parse_expr()
            push(stmts, Stmt.Expression(e))
          }
        }
      }
    }
  }
  stmts
}

// ─── try_parse_struct_destruct ──────────────────────────────────────────────
// Try to parse {field: binding, ...} := expr
// Returns @[Stmt] (multiple Bind stmts) on success, or @[] on failure.
// Desugars: {x: a, y: b} := pos  →  _sd := pos; a := _sd.x; b := _sd.y

try_parse_struct_destruct := () -> @[Stmt] {
  saved := ps_save()

  // Expect {
  if (not ps_check("LBrace")) {
    => @[]
  }
  ps_advance()

  // Parse field:binding pairs
  fields ::= @[]
  bindings ::= @[]
  ok ::= true

  while (ok and not ps_check("RBrace")) {
    fk := ps_peek_kind()
    if (fk != "Ident") {
      ok ::= false
    }
    if (ok) {
      field := ps_peek_ident()
      ps_advance()
      if (not ps_check("Colon")) {
        ok ::= false
      }
      if (ok) {
        ps_advance()
        bk := ps_peek_kind()
        if (bk != "Ident") {
          ok ::= false
        }
        if (ok) {
          binding := ps_peek_ident()
          ps_advance()
          push(fields, field)
          push(bindings, binding)
          dummy := ps_consume("Comma")
        } else {}
      }
    }
  }

  if (not ok or len(fields) == 0) {
    ps_restore(saved)
    => @[]
  }

  // Expect }
  if (not ps_check("RBrace")) {
    ps_restore(saved)
    => @[]
  }
  ps_advance()

  // Expect :=
  if (not ps_check("Assign")) {
    ps_restore(saved)
    => @[]
  }
  ps_advance()

  // Parse the RHS expression
  rhs := parse_expr()

  // Desugar: _sd0 := rhs; binding := _sd0.field; ...
  result ::= @[]
  tmp_name := ps_gensym("_sd")
  push(result, Stmt.Bind(tmp_name, rhs, @[]))
  i ::= 0
  while (i < len(fields)) {
    field_expr := Expr.Field(Expr.Var(tmp_name), fields[i])
    push(result, Stmt.Bind(bindings[i], field_expr, @[]))
    i ::= i + 1
  }
  result
}

parse_block_bind := () -> Stmt {
  saved := ps_save()
  k := ps_peek_kind()
  if (k != "Ident") {
    e := parse_expr()
    => Stmt.Expression(e)
  }
  name := ps_peek_ident()
  ps_advance()

  // Tuple bind: a, b := expr
  if (ps_check("Comma")) {
    names ::= @[name]
    while (ps_consume("Comma")) {
      nk := ps_peek_kind()
      if (nk == "Ident") {
        push(names, ps_peek_ident())
        ps_advance()
      } else {
        if (nk == "Underscore") {
          push(names, "_")
          ps_advance()
        } else {
          ps_restore(saved)
          e := parse_expr()
          => Stmt.Expression(e)
        }
      }
    }
    if (ps_check("Assign")) {
      ps_advance()
      rhs := parse_expr()
      pats ::= names | map((n) -> { if (n == "_") { Pat.Wild } else { Pat.Var(n) } })
      => Stmt.BindPat(Pat.Tuple(pats), rhs)
    }
    if (ps_check("MutAssign")) {
      ps_advance()
      rhs := parse_expr()
      pats ::= names | map((n) -> { if (n == "_") { Pat.Wild } else { Pat.Var(n) } })
      => Stmt.BindPatMut(Pat.Tuple(pats), rhs)
    }
    ps_restore(saved)
    e := parse_expr()
    => Stmt.Expression(e)
  }

  // Single bind: a := expr
  if (ps_check("Assign")) {
    ps_advance()
    rhs := parse_expr()
    => Stmt.Bind(name, rhs, @[])
  }
  if (ps_check("MutAssign")) {
    ps_advance()
    rhs := parse_expr()
    => Stmt.BindMut(name, rhs, @[])
  }

  // Lvalue: expr[idx] := rhs  or  expr.field := rhs
  if (ps_check("LBracket") or ps_check("Dot")) {
    ps_restore(saved)
    lhs := parse_expr()
    if (ps_check("Assign")) {
      ps_advance()
      rhs := parse_expr()
      => Stmt.Assign(expr_to_lvalue(lhs), rhs)
    }
    => Stmt.Expression(lhs)
  }

  // Fallback: expression
  ps_restore(saved)
  e := parse_expr()
  Stmt.Expression(e)
}

parse_block_stmts_braced := () -> @[Stmt] {
  ps_expect("LBrace")
  stmts ::= parse_block_stmts()
  ps_expect("RBrace")
  stmts
}

// ─── Expressions (precedence chain) ─────────────────────────────────────────

parse_expr := () -> Expr {
  parse_pipe()
}

parse_pipe := () -> Expr {
  lhs ::= parse_or()
  while (ps_check("Pipe")) {
    ps_advance()
    rhs := parse_postfix()
    lhs ::= Expr.Pipe(lhs, rhs)
  }
  lhs
}

parse_or := () -> Expr {
  lhs ::= parse_and()
  while (ps_check("Or")) {
    ps_advance()
    rhs := parse_and()
    lhs ::= Expr.BinOp(BinOp.Or, lhs, rhs)
  }
  lhs
}

parse_and := () -> Expr {
  lhs ::= parse_not()
  while (ps_check("And")) {
    ps_advance()
    rhs := parse_not()
    lhs ::= Expr.BinOp(BinOp.And, lhs, rhs)
  }
  lhs
}

parse_not := () -> Expr {
  if (ps_check("Not")) {
    ps_advance()
    e := parse_not()
    Expr.UnOp(UnOp.Not, e)
  } else {
    parse_cmp()
  }
}

parse_cmp := () -> Expr {
  lhs := parse_add_sub()
  k := ps_peek_kind()
  if (k == "Eq") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.Eq, lhs, rhs) }
  else { if (k == "Neq") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.Neq, lhs, rhs) }
  else { if (k == "Lt") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.Lt, lhs, rhs) }
  else { if (k == "Gt") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.Gt, lhs, rhs) }
  else { if (k == "Le") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.Le, lhs, rhs) }
  else { if (k == "Ge") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.Ge, lhs, rhs) }
  else { if (k == "In") { ps_advance()  rhs := parse_add_sub()  Expr.BinOp(BinOp.In, lhs, rhs) }
  else { if (k == "Not") {
    if (ps_same_line()) {
      ps_advance()
      ps_expect("In")
      rhs := parse_add_sub()
      Expr.BinOp(BinOp.NotIn, lhs, rhs)
    } else {
      lhs
    }
  } else {
    lhs
  }}}}}}}}
}

parse_add_sub := () -> Expr {
  lhs ::= parse_mul_div()
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "Plus") {
      ps_advance()
      rhs := parse_mul_div()
      lhs ::= Expr.BinOp(BinOp.Add, lhs, rhs)
    } else {
      if (k == "Minus") {
        ps_advance()
        rhs := parse_mul_div()
        lhs ::= Expr.BinOp(BinOp.Sub, lhs, rhs)
      } else {
        done ::= true
      }
    }
  }
  lhs
}

parse_mul_div := () -> Expr {
  lhs ::= parse_unary()
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "Star") {
      ps_advance()
      rhs := parse_unary()
      lhs ::= Expr.BinOp(BinOp.Mul, lhs, rhs)
    } else {
      if (k == "Slash") {
        ps_advance()
        rhs := parse_unary()
        lhs ::= Expr.BinOp(BinOp.Div, lhs, rhs)
      } else {
        if (k == "Percent") {
          ps_advance()
          rhs := parse_unary()
          lhs ::= Expr.BinOp(BinOp.Mod, lhs, rhs)
        } else {
          done ::= true
        }
      }
    }
  }
  lhs
}

parse_unary := () -> Expr {
  if (ps_check("Minus")) {
    ps_advance()
    e := parse_unary()
    Expr.UnOp(UnOp.Neg, e)
  } else {
    parse_postfix()
  }
}

parse_postfix := () -> Expr {
  e ::= parse_atom()
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "Dot") {
      ps_advance()
      fname := ps_advance_ident()
      if (ps_check("LParen")) {
        args := parse_arg_list()
        e ::= Expr.Call(Expr.Field(e, fname), args)
      } else {
        e ::= Expr.Field(e, fname)
      }
    } else {
      if (k == "LBracket" and ps_same_line()) {
        ps_advance()
        // Slice or index
        ik := ps_peek_kind()
        if (ik == "Colon") {
          // Slice with no start: [:end] or [:end:step] or [:]
          ps_advance()
          to := parse_opt_slice_expr()
          step := if (ps_consume("Colon")) { parse_opt_slice_expr() } else { none }
          ps_expect("RBracket")
          e ::= mk_expr_slice(e, none, to, step)
        } else {
          idx := parse_expr()
          if (ps_check("Colon")) {
            // Slice with start: [start:end] or [start:end:step]
            ps_advance()
            to := parse_opt_slice_expr()
            step := if (ps_consume("Colon")) { parse_opt_slice_expr() } else { none }
            ps_expect("RBracket")
            e ::= mk_expr_slice(e, Some(idx), to, step)
          } else {
            // Index
            ps_expect("RBracket")
            e ::= Expr.Index(e, idx)
          }
        }
      } else {
        if (k == "LParen" and ps_same_line()) {
          args := parse_arg_list()
          e ::= Expr.Call(e, args)
        } else {
          if (k == "Question") {
            ps_advance()
            e ::= Expr.TryUnwrap(e)
          } else {
            done ::= true
          }
        }
      }
    }
  }
  e
}

parse_opt_slice_expr := () -> Option<Expr> {
  k := ps_peek_kind()
  if (k == "RBracket" or k == "Colon") {
    none
  } else {
    Some(parse_expr())
  }
}

// ─── Atoms ──────────────────────────────────────────────────────────────────

parse_atom := () -> Expr {
  k := ps_peek_kind()
  if (k == "Int") {
    n := ps_peek_int()
    ps_advance()
    => Expr.Int(n)
  }
  if (k == "Float") {
    f := ps_peek_float()
    ps_advance()
    => Expr.Float(f)
  }
  if (k == "Bool") {
    b := ps_peek_bool()
    ps_advance()
    => Expr.Bool(b)
  }
  if (k == "Str") {
    s := ps_peek_str()
    ps_advance()
    => Expr.Str(s)
  }
  if (k == "Char") {
    c := ps_peek_char()
    ps_advance()
    => mk_expr_char_from_str(c)
  }
  if (k == "None") {
    ps_advance()
    => Expr.None
  }
  if (k == "LParen") {
    => parse_lambda_or_paren()
  }
  if (k == "At") {
    => parse_collection()
  }
  if (k == "If") {
    => parse_if_expr()
  }
  if (k == "Match") {
    => parse_match_expr()
  }
  if (k == "For") {
    => parse_for_expr()
  }
  if (k == "While") {
    => parse_while_expr()
  }
  if (k == "Break") {
    => parse_break_expr()
  }
  if (k == "Continue") {
    ps_advance()
    => Expr.Continue
  }
  if (k == "LBrace") {
    => parse_inline_block()
  }
  if (k == "Lt") {
    => parse_generic_lambda()
  }
  if (k == "Underscore") {
    ps_advance()
    => Expr.Var("_")
  }
  if (k == "Ident") {
    name := ps_peek_ident()
    ps_advance()
    if (ps_check("LBrace") and is_upper(name)) {
      fields ::= parse_struct_lit_fields()
      => Expr.Struct(Some(name), fields)
    }
    => Expr.Var(name)
  }
  // Unknown token
  if (not ps_has_err()) {
    ps_set_err("Unexpected token: ${k}")
  }
  Expr.None
}

// ─── Lambda vs parenthesised expr ───────────────────────────────────────────

parse_lambda_or_paren := () -> Expr {
  saved := ps_save()
  lambda := try_parse_lambda()
  if (not ps_has_err()) {
    lambda
  } else {
    ps_clear_err()
    ps_restore(saved)
    // Parenthesised expr or tuple
    ps_expect("LParen")
    e := parse_expr()
    if (ps_check("Comma")) {
      ps_advance()
      rest := parse_expr_sep("RParen")
      ps_expect("RParen")
      items ::= @[e] + rest
      Expr.Tuple(items)
    } else {
      ps_expect("RParen")
      e
    }
  }
}

try_parse_lambda := () -> Expr {
  ps_expect("LParen")
  params ::= parse_param_list()
  ps_expect("RParen")
  if (not ps_check("Arrow")) {
    ps_set_err("not a lambda")
    => Expr.None
  }
  ps_advance()
  // Return type
  rk := ps_peek_kind()
  ret_ty := if (rk == "LBrace") {
    none
  } else {
    if (rk == "Underscore") {
      ps_advance()
      none
    } else {
      Some(parse_type_expr())
    }
  }
  void_mark := if (rk == "Underscore") { Some(TypeExpr.Void) } else { none }
  stmts ::= parse_block_stmts_braced()
  ss, fe := split_block(stmts)
  Expr.Lambda(@[], params, ret_ty, void_mark, ss, fe)
}

parse_param_list := () -> @[Param] {
  if (ps_check("RParen")) {
    @[]
  } else {
    params ::= @[parse_one_param()]
    while (ps_consume("Comma")) {
      if (ps_check("RParen")) {
        break
      }
      push(params, parse_one_param())
    }
    params
  }
}

parse_one_param := () -> Param {
  k := ps_peek_kind()
  if (k == "Underscore") {
    ps_advance()
    => Param { name: "_", ty: none, mutable: false, default: none }
  }
  name := ps_advance_ident()
  // name::Type — mutable param
  if (ps_consume("DoubleColon")) {
    ty := parse_type_expr()
    => Param { name: name, ty: Some(ty), mutable: true, default: none }
  }
  // name:=expr — default param
  if (ps_consume("Assign")) {
    default := parse_expr()
    => Param { name: name, ty: none, mutable: false, default: Some(default) }
  }
  // name:Type — typed param
  if (ps_consume("Colon")) {
    ty := parse_type_expr()
    => Param { name: name, ty: Some(ty), mutable: false, default: none }
  }
  // name — untyped param
  Param { name: name, ty: none, mutable: false, default: none }
}

parse_arg_list := () -> @[Expr] {
  ps_expect("LParen")
  args := parse_expr_sep("RParen")
  ps_expect("RParen")
  args
}

parse_expr_sep := (stop: str) -> @[Expr] {
  if (ps_check(stop)) {
    @[]
  } else {
    items ::= @[parse_expr()]
    while (ps_consume("Comma")) {
      if (ps_check(stop)) {
        break
      }
      push(items, parse_expr())
    }
    items
  }
}

// ─── Collections ────────────────────────────────────────────────────────────

parse_collection := () -> Expr {
  ps_expect("At")
  k := ps_peek_kind()
  if (k == "LBracket") { parse_list() }
  else { if (k == "LBrace") { parse_dict_or_set() }
  else {
    ps_set_err("Expected [ or { after @")
    Expr.None
  }}
}

parse_list := () -> Expr {
  ps_expect("LBracket")
  if (ps_check("RBracket")) {
    ps_advance()
    Expr.List(@[])
  } else {
    items ::= parse_expr_sep("RBracket")
    ps_expect("RBracket")
    Expr.List(items)
  }
}

parse_dict_or_set := () -> Expr {
  ps_expect("LBrace")
  if (ps_check("RBrace")) {
    // @{} — empty dict (backward compat)
    ps_advance()
    Expr.Dict(new_expr_pairs())
  } else {
    // Parse first expression, then peek: Colon → dict, Comma/RBrace → set
    first := parse_expr()
    if (ps_check("Colon")) {
      // Dict: @{key: val, ...}
      ps_advance()
      v := parse_expr()
      pairs ::= new_expr_pairs()
      pairs ::= push_expr_pair(pairs, first, v)
      while (ps_consume("Comma")) {
        if (ps_check("RBrace")) { break }
        k2 := parse_expr()
        ps_expect("Colon")
        v2 := parse_expr()
        pairs ::= push_expr_pair(pairs, k2, v2)
      }
      ps_expect("RBrace")
      Expr.Dict(pairs)
    } else {
      // Set: @{a, b, ...}
      items ::= @[first]
      while (ps_consume("Comma")) {
        if (ps_check("RBrace")) { break }
        push(items, parse_expr())
      }
      ps_expect("RBrace")
      Expr.Set(items)
    }
  }
}

parse_struct_lit_fields := () -> @[(str, Expr)] {
  ps_expect("LBrace")
  fields ::= new_name_expr_pairs()
  done ::= false
  while (not done) {
    k := ps_peek_kind()
    if (k == "RBrace") {
      done ::= true
    } else {
      if (k == "Ident") {
        name := ps_peek_ident()
        ps_advance()
        ps_expect("Colon")
        v := parse_expr()
        ps_consume("Comma")
        fields ::= push_name_expr_pair(fields, name, v)
      } else {
        done ::= true
      }
    }
  }
  ps_expect("RBrace")
  fields
}

// ─── Control flow ───────────────────────────────────────────────────────────

parse_if_expr := () -> Expr {
  ps_expect("If")
  ps_expect("LParen")
  cond := parse_expr()
  ps_expect("RParen")
  then_stmts := parse_block_stmts_braced()
  ts, te := split_block(then_stmts)
  else_clause := if (ps_check("Else")) {
    ps_advance()
    else_stmts := parse_block_stmts_braced()
    es, ee := split_block(else_stmts)
    some_else(es, ee)
  } else {
    no_else()
  }
  Expr.If(cond, ts, te, else_clause)
}

parse_match_expr := () -> Expr {
  ps_expect("Match")
  scrut := parse_expr()
  ps_expect("LBrace")
  arms ::= @[]
  while (not ps_check("RBrace") and not ps_has_err()) {
    push(arms, parse_match_arm())
  }
  ps_expect("RBrace")
  Expr.Match(scrut, arms)
}

parse_match_arm := () -> MatchArm {
  first_pat := parse_pat()
  // Or-pattern: collect alternatives separated by | (Pipe token)
  pat := if (ps_check("Pipe")) {
    pats ::= @[first_pat]
    while (ps_check("Pipe")) {
      ps_advance()
      push(pats, parse_pat())
    }
    Pat.Or(pats)
  } else {
    first_pat
  }
  guard := if (ps_check("If")) {
    ps_advance()
    Some(parse_expr())
  } else {
    none
  }
  ps_expect("Arrow")
  body := parse_expr()
  MatchArm { pat: pat, guard: guard, body: body }
}

parse_more_pats := () -> @[Pat] {
  pats ::= @[parse_pat()]
  while (ps_check("Comma")) {
    ps_advance()
    push(pats, parse_pat())
  }
  pats
}

parse_pat := () -> Pat {
  k := ps_peek_kind()
  if (k == "Underscore") {
    ps_advance()
    => Pat.Wild
  }
  if (k == "None") {
    ps_advance()
    => Pat.None
  }
  if (k == "Ident") {
    name := ps_peek_ident()
    ps_advance()
    if (ps_check("Dot")) {
      ps_advance()
      vname := ps_advance_ident()
      full := "${name}.${vname}"
      if (ps_check("LParen")) {
        ps_advance()
        if (ps_check("RParen")) {
          ps_advance()
          => Pat.Enum(full, @[])
        }
        epats ::= @[parse_pat()]
        while (ps_consume("Comma")) {
          if (ps_check("RParen")) { break }
          push(epats, parse_pat())
        }
        ps_expect("RParen")
        if (len(epats) == 1) {
          => Pat.Enum(full, @[epats[0]])
        }
        => Pat.Enum(full, epats)
      }
      => Pat.Enum(full, @[])
    }
    if (ps_check("LParen") and ps_same_line()) {
      ps_advance()
      if (ps_check("RParen")) {
        ps_advance()
        => Pat.Enum(name, @[])
      }
      epats ::= @[parse_pat()]
      while (ps_consume("Comma")) {
        if (ps_check("RParen")) { break }
        push(epats, parse_pat())
      }
      ps_expect("RParen")
      if (len(epats) == 1) {
        => Pat.Enum(name, @[epats[0]])
      }
      => Pat.Enum(name, epats)
    }
    => Pat.Var(name)
  }
  if (k == "Int") {
    n := ps_peek_int()
    ps_advance()
    => Pat.Lit(Expr.Int(n))
  }
  if (k == "Float") {
    f := ps_peek_float()
    ps_advance()
    => Pat.Lit(Expr.Float(f))
  }
  if (k == "Bool") {
    b := ps_peek_bool()
    ps_advance()
    => Pat.Lit(Expr.Bool(b))
  }
  if (k == "Str") {
    s := ps_peek_str()
    ps_advance()
    => Pat.Lit(Expr.Str(s))
  }
  if (k == "Char") {
    c := ps_peek_char()
    ps_advance()
    => Pat.Lit(mk_expr_char_from_str(c))
  }
  if (k == "Minus") {
    ps_advance()
    nk := ps_peek_kind()
    if (nk == "Int") {
      n := ps_peek_int()
      ps_advance()
      => Pat.Lit(Expr.Int(0 - n))
    }
    if (nk == "Float") {
      f := ps_peek_float()
      ps_advance()
      => Pat.Lit(Expr.Float(-f))
    }
    ps_set_err("Expected number after '-' in pattern")
    => Pat.Wild
  }
  if (k == "LParen") {
    ps_advance()
    if (ps_check("RParen")) {
      ps_advance()
      => Pat.Tuple(@[])
    }
    pats ::= @[parse_pat()]
    while (ps_consume("Comma")) {
      if (ps_check("RParen")) {
        break
      }
      push(pats, parse_pat())
    }
    ps_expect("RParen")
    => Pat.Tuple(pats)
  }
  if (not ps_has_err()) {
    ps_set_err("Expected pattern, got ${k}")
  }
  Pat.Wild
}

// ─── Loops ──────────────────────────────────────────────────────────────────

parse_for_expr := () -> Expr {
  ps_expect("For")
  k := ps_peek_kind()
  var_name := if (k == "Underscore") {
    ps_advance()
    "_"
  } else {
    ps_advance_ident()
  }
  ps_expect("In")
  iter := parse_expr()
  stmts ::= parse_block_stmts_braced()
  ss, fe := split_block(stmts)
  mk_expr_for(var_name, iter, ss, Some(fe))
}

parse_while_expr := () -> Expr {
  ps_expect("While")
  ps_expect("LParen")
  cond := parse_expr()
  ps_expect("RParen")
  stmts ::= parse_block_stmts_braced()
  ss, fe := split_block(stmts)
  mk_expr_while(cond, ss, Some(fe))
}

parse_break_expr := () -> Expr {
  ps_expect("Break")
  Expr.Break(none)
}

parse_inline_block := () -> Expr {
  stmts ::= parse_block_stmts_braced()
  ss, fe := split_block(stmts)
  Expr.Block(ss, fe)
}

// ─── Types ──────────────────────────────────────────────────────────────────

parse_type_expr := () -> TypeExpr {
  k := ps_peek_kind()
  if (k == "At") {
    ps_advance()
    ak := ps_peek_kind()
    if (ak == "LBracket") {
      ps_advance()
      ty := parse_type_expr()
      ps_expect("RBracket")
      => TypeExpr.List(ty)
    }
    if (ak == "LBrace") {
      ps_advance()
      kty := parse_type_expr()
      ps_expect("Colon")
      vty := parse_type_expr()
      ps_expect("RBrace")
      => TypeExpr.Dict(kty, vty)
    }
    if (ak == "LParen") {
      ps_advance()
      ty := parse_type_expr()
      ps_expect("RParen")
      => TypeExpr.Set(ty)
    }
    => TypeExpr.Infer
  }
  if (k == "LParen") {
    ps_advance()
    types ::= @[parse_type_expr()]
    while (ps_consume("Comma")) {
      push(types, parse_type_expr())
    }
    ps_expect("RParen")
    => TypeExpr.Tuple(types)
  }
  if (k == "Underscore") {
    ps_advance()
    => TypeExpr.Void
  }
  if (k == "Ident") {
    name := ps_peek_ident()
    ps_advance()
    if (ps_check("Lt")) {
      ps_advance()
      params ::= @[parse_type_expr()]
      while (ps_consume("Comma")) {
        push(params, parse_type_expr())
      }
      ps_expect("Gt")
      => TypeExpr.Generic(name, params)
    }
    => TypeExpr.Name(name)
  }
  TypeExpr.Infer
}

// ─── Generic lambda ──────────────────────────────────────────────────────────
// Parses `<T: Trait + Trait, U>(params) -> ret { body }`

parse_generic_lambda := () -> Expr {
  ps_expect("Lt")
  generics := parse_generic_param_list()
  ps_expect("Gt")
  ps_expect("LParen")
  params ::= parse_param_list()
  ps_expect("RParen")
  if (not ps_check("Arrow")) {
    ps_set_err("expected -> after generic lambda params")
    => Expr.None
  }
  ps_advance()
  rk := ps_peek_kind()
  ret_ty := if (rk == "LBrace") {
    none
  } else {
    if (rk == "Underscore") {
      ps_advance()
      none
    } else {
      Some(parse_type_expr())
    }
  }
  void_mark := if (rk == "Underscore") { Some(TypeExpr.Void) } else { none }
  stmts ::= parse_block_stmts_braced()
  ss, fe := split_block(stmts)
  Expr.Lambda(generics, params, ret_ty, void_mark, ss, fe)
}

parse_generic_param_list := () -> @[str] {
  result ::= @[]
  name := ps_advance_ident()
  g_str := if (ps_consume("Colon")) {
    first_bound := ps_advance_ident()
    bounds ::= @[first_bound]
    while (ps_check("Plus")) {
      ps_advance()
      push(bounds, ps_advance_ident())
    }
    name + ": " + join(bounds, " + ")
  } else {
    name
  }
  push(result, g_str)
  while (ps_consume("Comma")) {
    if (ps_check("Gt")) { break }
    name2 := ps_advance_ident()
    g_str2 := if (ps_consume("Colon")) {
      b1 := ps_advance_ident()
      bounds2 ::= @[b1]
      while (ps_check("Plus")) {
        ps_advance()
        push(bounds2, ps_advance_ident())
      }
      name2 + ": " + join(bounds2, " + ")
    } else {
      name2
    }
    push(result, g_str2)
  }
  result
}
