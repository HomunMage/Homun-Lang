// codegen.hom — Code generator: walks the Homun AST and emits Rust source text.
//
// Ports codegen.rs logic to .hom using:
//   src/scope.hom          — Scope (@[str]) wrapper
//   src/codegen_imp.rs     — type aliases, TLS registries, Expr accessors
//
// Match arms on self-recursive enum variants (Expr, TypeExpr) auto-deref
// Box<T> fields via the variant_field_types registry (populated by --import
// pre-pass or codegen_program_with_resolved's DFS pre-pass).
// Lambda has named fields and is handled via early-out before the match.
//
// Public API:
//   codegen_program_with_resolved(prog, hom_files, rs_content) -> str

// `use codegen_imp` sets has_rs_dep=true so homunc skips undefined-reference
// checks for runtime functions (join, push, replace, etc.)
use codegen_imp
use scope


// ─── local string/list helpers (migrated from dep/codegen_helpers.rs) ────────
// Pure utilities expressed directly in .hom over runtime primitives (repeat,
// join, is_upper, char_at — all in scope via lib.rs `use crate::runtime::*`).

// n levels of 4-space indentation.
ind := (n: int) -> str { repeat(" ", n * 4) }

// True if the first character of s is uppercase (false on empty string).
// Distinguishes enum variants (PascalCase) from struct fields in codegen.
is_upper_first := (s: str) -> bool { not is_empty(s) and is_upper(char_at(s, 0)) }

// Format a generic clause: "<T, U>" when non-empty, "" when empty.
generics_str := (generics: @[str]) -> str {
  if (len(generics) == 0) { "" } else { "<" + join(generics, ", ") + ">" }
}

// True if name is a Homun builtin emitted as a Rust macro (name!(...)).
// Equality chain (not `in @[...]`) so a String needle compares against str
// literals without the &String/&str coercion the `in` form can't express.
is_homun_macro := (name: str) -> bool {
  name == "range" or name == "len" or name == "filter" or name == "map"
    or name == "reduce" or name == "slice" or name == "dict" or name == "set"
}


// ─── fn-signature registry (logic) ───────────────────────────────────────────
// State lives in dep/codegen_helpers.rs (FN_MUT_PARAMS, FN_DEFAULTS,
// CURRENT_MUT_REF_PARAMS). These functions hold the logic; the dep primitives
// fn_mut_params_insert / fn_defaults_insert / current_mut_ref_params_* / etc.
// handle raw storage.

register_known_dep_fns := () -> _ {
  fn_mut_params_insert("heap_push",     @[true, false, false])
  fn_mut_params_insert("heap_pop",      @[true])
  fn_mut_params_insert("heap_len",      @[true])
  fn_mut_params_insert("heap_is_empty", @[true])
  fn_defaults_insert("heap_push",     @[none, none, none])
  fn_defaults_insert("heap_pop",      @[none])
  fn_defaults_insert("heap_len",      @[none])
  fn_defaults_insert("heap_is_empty", @[none])

  // set/dict mutators (use set, use dict). First arg is &mut.
  fn_mut_params_insert("set_add",     @[true, false])
  fn_mut_params_insert("set_remove",  @[true, false])
  fn_mut_params_insert("set_clear",   @[true])
  fn_mut_params_insert("dict_insert", @[true, false, false])
  fn_mut_params_insert("dict_remove", @[true, false])
  fn_mut_params_insert("dict_clear",  @[true])
  fn_defaults_insert("set_add",     @[none, none])
  fn_defaults_insert("set_remove",  @[none, none])
  fn_defaults_insert("set_clear",   @[none])
  fn_defaults_insert("dict_insert", @[none, none, none])
  fn_defaults_insert("dict_remove", @[none, none])
  fn_defaults_insert("dict_clear",  @[none])
}

// ─── register_external_types ──────────────────────────────────────────────────
// Pre-register variant field types from an externally-parsed AST (e.g. via
// --import) so match auto-deref and construct auto-wrap work cross-file.

register_external_types := (stmts: @[Stmt]) -> _ {
  n := len(stmts)
  j ::= 0
  while (j < n) {
    match stmts[j] {
      Stmt.EnumDef(ename, variants, _) -> {
        nv := len(variants)
        vi ::= 0
        while (vi < nv) {
          v := variants[vi]
          vfields := v.fields
          field_tys ::= @[]
          fi ::= 0
          nf := len(vfields)
          while (fi < nf) {
            fname_opt, fty := vfields[fi]
            push(field_tys, fty)
            fi ::= fi + 1
          }
          qual := "${ename}.${v.name}"
          register_variant_field_types(qual, field_tys)
          vi ::= vi + 1
        }
      }
      _ -> {}
    }
    j ::= j + 1
  }
}


register_fn_sig := (name: str, params: @[Param]) -> _ {
  flags ::= @[]
  defaults ::= @[]
  pi ::= 0
  while (pi < len(params)) {
    p := params[pi]
    push(flags, p.mutable)
    push(defaults, p.default)
    pi ::= pi + 1
  }
  fn_mut_params_insert(name, flags)
  fn_defaults_insert(name, defaults)
}

set_current_mut_ref_params := (params: @[Param]) -> _ {
  current_mut_ref_params_clear()
  pi ::= 0
  while (pi < len(params)) {
    p := params[pi]
    if (p.mutable) {
      current_mut_ref_params_add(p.name)
    }
    pi ::= pi + 1
  }
}

fill_default_args := (fn_name: str, args: @[Expr]) -> @[Expr] {
  defs := fn_defaults_get_for(fn_name)
  n_args := len(args)
  n_params := len(defs)
  if (n_args >= n_params) { => args }
  has_all ::= true
  mi ::= n_args
  while (mi < n_params) {
    match defs[mi] {
      none -> { has_all ::= false }
      _ -> {}
    }
    mi ::= mi + 1
  }
  if (not has_all) { => args }
  result ::= args
  fi ::= n_args
  while (fi < n_params) {
    match defs[fi] {
      Some(default_expr) -> { push(result, default_expr) }
      none -> {}
    }
    fi ::= fi + 1
  }
  result
}


// ─── escape_str ───────────────────────────────────────────────────────────────
// Escape special chars for embedding in a Rust string literal.

escape_str := (s: str) -> str {
  cs := chars(s)
  out ::= str("")
  i ::= 0
  n := len(cs)
  while (i < n) {
    c := cs[i]
    if (c == "\"") { out ::= out + "\\\"" }
    else { if (c == "\\") { out ::= out + "\\\\" }
    else { if (c == "\n") { out ::= out + "\\n" }
    else { if (c == "\t") { out ::= out + "\\t" }
    else { out ::= out + str(c) } } } }
    i ::= i + 1
  }
  out
}


// ─── parse_interp ─────────────────────────────────────────────────────────────
// Parse a Homun string for ${} interpolation.
// Returns (format_string, vec_of_arg_expressions).

parse_interp := (s: str) -> (str, @[str]) {
  cs := chars(s)
  n := len(cs)
  fmt ::= str("")
  args ::= @[]
  i ::= 0
  while (i < n) {
    c := cs[i]
    if (c == "{" and i + 1 < n and cs[i + 1] == "{") {
      fmt ::= fmt + "{{"
      i ::= i + 2
    } else {
      if (c == "$" and i + 1 < n and cs[i + 1] == "{") {
        i ::= i + 2
        expr_s ::= str("")
        while (i < n and cs[i] != "}") {
          expr_s ::= expr_s + str(cs[i])
          i ::= i + 1
        }
        push(args, expr_s)
        fmt ::= fmt + "{}"
        if (i < n) {
          i ::= i + 1
        }
      } else {
        if (c == "\"") {
          fmt ::= fmt + "\\\""
        } else {
          fmt ::= fmt + str(c)
        }
        i ::= i + 1
      }
    }
  }
  (fmt, args)
}


// ─── codegen_string ───────────────────────────────────────────────────────────
// Render a Homun string value as a Rust string expression.

codegen_string := (s: str) -> str {
  fmt_str, fmt_args := parse_interp(s)
  if (len(fmt_args) == 0) {
    "\"" + escape_str(s) + "\""
  } else {
    "format!(\"" + fmt_str + "\", " + join(fmt_args, ", ") + ")"
  }
}


// ─── codegen_type ─────────────────────────────────────────────────────────────
// Convert a Homun TypeExpr to its Rust type spelling.

codegen_type := (ty: TypeExpr) -> str {
  ty_d := ty
  match ty_d {
    TypeExpr.Name(n) -> {
      match n {
        "int"   -> "i32"
        "float" -> "f32"
        "bool"  -> "bool"
        "str"   -> "String"
        "char"  -> "char"
        "none"  -> "Option<_>"
        _       -> n
      }
    }
    TypeExpr.List(inner) -> "Vec<" + codegen_type(inner) + ">"
    TypeExpr.Dict(k, v) -> {
      ks := codegen_type(k)
      vs := codegen_type(v)
      "std::collections::HashMap<" + ks + ", " + vs + ">"
    }
    TypeExpr.Set(inner) -> "std::collections::HashSet<" + codegen_type(inner) + ">"
    TypeExpr.Option(inner) -> "Option<" + codegen_type(inner) + ">"
    TypeExpr.Tuple(ts) -> {
      parts ::= @[]
      ti ::= 0
      while (ti < len(ts)) {
        push(parts, codegen_type(ts[ti]))
        ti ::= ti + 1
      }
      "(" + join(parts, ", ") + ")"
    }
    TypeExpr.Generic(gn, gps) -> {
      parts ::= @[]
      gi ::= 0
      while (gi < len(gps)) {
        push(parts, codegen_type(gps[gi]))
        gi ::= gi + 1
      }
      gn + "<" + join(parts, ", ") + ">"
    }
    TypeExpr.Void -> "()"
    TypeExpr.Infer -> "_"
  }
}


// ─── codegen_type_variant_field ───────────────────────────────────────────────
// Like codegen_type but wraps self-recursive names in Box<...>.

codegen_type_variant_field := (ty: TypeExpr) -> str {
  ty_d := ty
  match ty_d {
    TypeExpr.Name(n) -> {
      if (is_self_recursive_type(n)) {
        "Box<" + n + ">"
      } else {
        codegen_type(ty)
      }
    }
    TypeExpr.Option(inner) -> {
      "Option<" + codegen_type_variant_field(inner) + ">"
    }
    TypeExpr.Generic(gn, gps) -> {
      if (gn == "Option" and len(gps) == 1) {
        "Option<" + codegen_type_variant_field(gps[0]) + ">"
      } else {
        codegen_type(ty)
      }
    }
    TypeExpr.Tuple(ts) -> {
      parts ::= @[]
      ti ::= 0
      while (ti < len(ts)) {
        push(parts, codegen_type_variant_field(ts[ti]))
        ti ::= ti + 1
      }
      "(" + join(parts, ", ") + ")"
    }
    _ -> codegen_type(ty)
  }
}


// ─── codegen_param ────────────────────────────────────────────────────────────
// Render a single param without mut prefix (for inline lambdas).

codegen_param := (p: Param) -> str {
  n := p.name
  if (n == "_") {
    "_: _"
  } else {
    match p.ty {
      none    -> n + ": _"
      Some(t) -> n + ": " + codegen_type(t)
    }
  }
}


// ─── codegen_params_mut ───────────────────────────────────────────────────────
// Render a param list with mut/&mut for top-level function signatures.

codegen_params_mut := (params: @[Param]) -> str {
  gen_names := @["T", "U", "V", "W", "X", "Y", "Z"]
  gen_idx ::= 0
  parts ::= @[]
  pi ::= 0
  pn := len(params)
  while (pi < pn) {
    p := params[pi]
    pname := p.name
    pmut := p.mutable
    part := if (pname == "_") {
      "_: _"
    } else {
      if (pmut) {
        match p.ty {
          Some(t) -> pname + ": &mut " + codegen_type(t)
          none    -> {
            g := gen_names[gen_idx]
            gen_idx ::= gen_idx + 1
            pname + ": &mut " + str(g)
          }
        }
      } else {
        match p.ty {
          Some(t) -> "mut " + pname + ": " + codegen_type(t)
          none    -> {
            g := gen_names[gen_idx]
            gen_idx ::= gen_idx + 1
            "mut " + pname + ": " + str(g)
          }
        }
      }
    }
    push(parts, part)
    pi ::= pi + 1
  }
  join(parts, ", ")
}


// ─── infer_generics ───────────────────────────────────────────────────────────
// Infer generic type params needed for a function (one per un-typed param).

infer_generics := (params: @[Param]) -> @[str] {
  gen_names := @["T", "U", "V", "W", "X", "Y", "Z"]
  n ::= 0
  pi ::= 0
  while (pi < len(params)) {
    p := params[pi]
    if (p.name != "_") {
      match p.ty {
        none -> { n ::= n + 1 }
        _ -> {}
      }
    }
    pi ::= pi + 1
  }
  result ::= @[]
  gi ::= 0
  while (gi < n) {
    push(result, str(gen_names[gi]) + ": Clone")
    gi ::= gi + 1
  }
  result
}


// ─── pat_names_list ───────────────────────────────────────────────────────────
// Flat list of variable names bound by a pattern (for BindPat scope insertion).

pat_names_list := (pat: Pat) -> @[str] {
  match pat {
    Pat.Var(name) -> @[name]
    Pat.Tuple(pats) -> {
      n := len(pats)
      names ::= @[]
      i ::= 0
      while (i < n) {
        names ::= vec_extend(names, pat_names_list(pats[i]))
        i ::= i + 1
      }
      names
    }
    _ -> @[]
  }
}


// ─── cg_clone_arg ─────────────────────────────────────────────────────────────
// Emit a function argument with clone/to_string as needed.

cg_clone_arg := (i: int, sc: Scope, e: Expr) -> str {
  e_d := e
  match e_d {
    Expr.Var(n) -> n + ".clone()"
    Expr.Str(s) -> codegen_string(s) + ".to_string()"
    Expr.Field(_, _) -> cg_expr(i, sc, e) + ".clone()"
    _ -> cg_expr(i, sc, e)
  }
}


// ─── cg_commas ────────────────────────────────────────────────────────────────
// Comma-join a list of expressions.

cg_commas := (i: int, sc: Scope, items: @[Expr]) -> str {
  n := len(items)
  parts ::= @[]
  k ::= 0
  while (k < n) {
    push(parts, cg_expr(i, sc, items[k]))
    k ::= k + 1
  }
  join(parts, ", ")
}


// ─── cg_lvalue ────────────────────────────────────────────────────────────────
// Emit an lvalue for assignment (uses [idx as usize] not .homun_idx).

cg_lvalue := (i: int, sc: Scope, lv: LValue) -> str {
  match lv {
    LValue.Var(n) -> n
    LValue.Field(base, name) -> cg_lvalue(i, sc, base) + "." + name
    LValue.Index(base, idx) -> cg_lvalue(i, sc, base) + "[" + cg_expr(i, sc, idx) + " as usize]"
  }
}


// ─── cg_pat ───────────────────────────────────────────────────────────────────
// Emit a pattern string for match arms.

cg_pat := (p: Pat) -> str {
  match p {
    Pat.Wild -> "_"
    Pat.None -> "None"
    Pat.Var(name) -> name
    Pat.Lit(e) -> cg_expr(0, scope_new(), e)
    Pat.Tuple(pats) -> {
      n := len(pats)
      parts ::= @[]
      i ::= 0
      while (i < n) {
        push(parts, cg_pat(pats[i]))
        i ::= i + 1
      }
      "(" + join(parts, ", ") + ")"
    }
    Pat.Enum(name, epats) -> {
      name2 := replace(name, ".", "::")
      n := len(epats)
      if (n == 0) {
        name2
      } else {
        if (n == 1) {
          name2 + "(" + cg_pat(epats[0]) + ")"
        } else {
          parts ::= @[]
          pi ::= 0
          while (pi < n) {
            push(parts, cg_pat(epats[pi]))
            pi ::= pi + 1
          }
          name2 + "(" + join(parts, ", ") + ")"
        }
      }
    }
    Pat.Or(or_pats) -> {
      n := len(or_pats)
      parts ::= @[]
      i ::= 0
      while (i < n) {
        push(parts, cg_pat(or_pats[i]))
        i ::= i + 1
      }
      join(parts, " | ")
    }
  }
}


// ─── Box<T> auto-deref support ────────────────────────────────────────────────
// When matching a self-recursive enum variant whose field type is the enum
// itself (or wraps one inside Option/Tuple), codegen_type_variant_field wraps
// it in Box<T>. So a binding like `List.Cons(_, Some(rest))` produces
// `rest: Box<List>` in Rust. These helpers detect such bindings so cg_arm can
// emit `let rest = *rest;` rebindings to give the body a plain `List` value.

walk_pat_box_names := (pat: Pat, ty: TypeExpr, enum_name: str) -> @[str] {
  match pat {
    Pat.Var(name) -> {
      ty_d := ty
      match ty_d {
        TypeExpr.Name(n) -> {
          if (n == enum_name) { @[name] } else { @[] }
        }
        _ -> @[]
      }
    }
    Pat.Enum(qual, inner) -> {
      is_some := (qual == "Some" or qual == "Option.Some") and len(inner) == 1
      if (is_some) {
        ty_d := ty
        match ty_d {
          TypeExpr.Option(opt_inner) -> walk_pat_box_names(inner[0], opt_inner, enum_name)
          TypeExpr.Generic(gn, gps) -> {
            if (gn == "Option" and len(gps) == 1) {
              walk_pat_box_names(inner[0], gps[0], enum_name)
            } else {
              @[]
            }
          }
          _ -> @[]
        }
      } else {
        @[]
      }
    }
    Pat.Tuple(pats) -> {
      ty_d := ty
      match ty_d {
        TypeExpr.Tuple(tys) -> {
          np := len(pats)
          nt := len(tys)
          n := if (np < nt) { np } else { nt }
          result ::= @[]
          i ::= 0
          while (i < n) {
            names ::= walk_pat_box_names(pats[i], tys[i], enum_name)
            result ::= vec_extend(result, names)
            i ::= i + 1
          }
          result
        }
        _ -> @[]
      }
    }
    _ -> @[]
  }
}

pat_box_var_names := (pat: Pat) -> @[str] {
  match pat {
    Pat.Enum(qual_name, sub_pats) -> {
      dot := find(qual_name, ".")
      if (dot < 0) {
        @[]
      } else {
        if (not variant_field_types_known(qual_name)) {
          @[]
        } else {
          enum_name := substr(qual_name, 0, dot)
          fields ::= variant_field_types_get(qual_name)
          nf := len(fields)
          np := len(sub_pats)
          n := if (np < nf) { np } else { nf }
          result ::= @[]
          i ::= 0
          while (i < n) {
            names ::= walk_pat_box_names(sub_pats[i], fields[i], enum_name)
            result ::= vec_extend(result, names)
            i ::= i + 1
          }
          result
        }
      }
    }
    _ -> @[]
  }
}


// ─── cg_struct_val ────────────────────────────────────────────────────────────
// Emit a struct field value with .to_string() for string literals.

cg_struct_val := (i: int, sc: Scope, e: Expr) -> str {
  e_d := e
  match e_d {
    Expr.Str(s) -> codegen_string(s) + ".to_string()"
    _ -> cg_expr(i, sc, e)
  }
}


// ─── cg_general_call ──────────────────────────────────────────────────────────
// Emit f(clone_args) for a general function call.
//
// Construct-side Box<T> auto-wrap: when `f` is a variant constructor and a
// field's declared type is the enum itself (self-recursive → Box<T>), wrap
// the arg with `Box::new(...)`. Only handles direct recursive fields;
// nested Option<T>/Tuple recursion still needs accessors.

// Returns "EnumName.VariantName" if f is a variant constructor, else "".
detect_variant_qual := (f: Expr) -> str {
  fd := f
  match fd {
    Expr.Field(base, name) -> {
      bd := base
      match bd {
        Expr.Var(en) -> {
          if (is_upper_first(en) and is_upper_first(name)) {
            "${en}.${name}"
          } else { "" }
        }
        _ -> ""
      }
    }
    _ -> ""
  }
}

// If `field_ty` is TypeExpr.Name(enum_name), wrap arg_s with Box::new(...).
maybe_box_wrap := (arg_s: str, field_ty: TypeExpr, enum_name: str) -> str {
  td := field_ty
  match td {
    TypeExpr.Name(n) -> {
      if (n == enum_name) { "Box::new(" + arg_s + ")" } else { arg_s }
    }
    _ -> arg_s
  }
}

cg_general_call := (i: int, sc: Scope, f: Expr, args: @[Expr]) -> str {
  f_m := f
  fn_name := match f_m {
    Expr.Var(n) -> n
    _ -> ""
  }
  filled_args := if (fn_name != "") {
    fill_default_args(fn_name, args)
  } else {
    args
  }
  // variant constructor detection (for Box auto-wrap)
  qual := detect_variant_qual(f)
  has_box_info := qual != "" and variant_field_types_known(qual)
  field_tys ::= if (has_box_info) { variant_field_types_get(qual) } else { @[] }
  enum_name := if (has_box_info) {
    dot := find(qual, ".")
    substr(qual, 0, dot)
  } else { "" }
  nft := len(field_tys)
  n := len(filled_args)
  arg_strs ::= @[]
  ai ::= 0
  while (ai < n) {
    arg_s ::= if (fn_name != "" and is_param_mutable_in_call(fn_name, ai)) {
      match filled_args[ai] {
        Expr.Var(vn) -> {
          if (is_mut_ref_param(vn)) { vn } else { "&mut " + vn }
        }
        _ -> "&mut (" + cg_expr(i, sc, filled_args[ai]) + ")"
      }
    } else {
      cg_clone_arg(i, sc, filled_args[ai])
    }
    arg_s ::= if (has_box_info and ai < nft) {
      maybe_box_wrap(arg_s, field_tys[ai], enum_name)
    } else {
      arg_s
    }
    push(arg_strs, arg_s)
    ai ::= ai + 1
  }
  cg_expr(i, sc, f) + "(" + join(arg_strs, ", ") + ")"
}


// ─── Expression predicates ───────────────────────────────────────────────────

is_str_expr := (expr: Expr) -> bool {
  match expr {
    Expr.Str(_) -> true
    Expr.BinOp(BinOp.Add, l, r) -> is_str_expr(l) or is_str_expr(r)
    Expr.Call(f, _) -> {
      match f {
        Expr.Var(n) -> n == "str"
        _ -> false
      }
    }
    _ -> false
  }
}

is_list_expr := (expr: Expr) -> bool {
  match expr {
    Expr.List(_) -> true
    Expr.Slice(_, _, _, _) -> true
    Expr.BinOp(BinOp.Add, l, r) -> is_list_expr(l) or is_list_expr(r)
    _ -> false
  }
}


// ─── cg_bin_op ────────────────────────────────────────────────────────────────
// Emit a binary operation.

cg_bin_op := (i: int, sc: Scope, op: BinOp, lhs: Expr, rhs: Expr) -> str {
  l := cg_expr(i, sc, lhs)
  r := cg_expr(i, sc, rhs)
  match op {
    BinOp.Add -> {
      if (is_list_expr(lhs) or is_list_expr(rhs)) {
        "homun_concat(" + l + ", " + r + ")"
      } else {
        if (is_str_expr(lhs) or is_str_expr(rhs)) {
          lhs_d := lhs
          ls := match lhs_d {
            Expr.Str(_) -> l + ".to_string()"
            _ -> l
          }
          ls + " + &" + r
        } else {
          l + " + " + r
        }
      }
    }
    BinOp.Sub -> l + " - " + r
    BinOp.Mul -> l + " * " + r
    BinOp.Div -> l + " / " + r
    BinOp.Mod -> l + " % " + r
    BinOp.Eq -> l + " == " + r
    BinOp.Neq -> l + " != " + r
    BinOp.Lt -> l + " < " + r
    BinOp.Gt -> l + " > " + r
    BinOp.Le -> l + " <= " + r
    BinOp.Ge -> l + " >= " + r
    BinOp.And -> l + " && " + r
    BinOp.Or -> l + " || " + r
    BinOp.In -> "homun_in!(" + l + ", " + r + ")"
    BinOp.NotIn -> "!homun_in!(" + l + ", " + r + ")"
  }
}


// ─── cg_print ─────────────────────────────────────────────────────────────────
// Emit a println! call for print(args).

cg_print := (i: int, sc: Scope, args: @[Expr]) -> str {
  n := len(args)
  if (n == 1) {
    arg0 := args[0]
    match arg0 {
      Expr.Str(s) -> {
        fmt_str, fmt_args := parse_interp(s)
        if (len(fmt_args) == 0) {
          "println!(\"" + fmt_str + "\")"
        } else {
          "println!(\"" + fmt_str + "\", " + join(fmt_args, ", ") + ")"
        }
      }
      _ -> "println!(\"{}\", " + cg_expr(i, sc, args[0]) + ")"
    }
  } else {
    parts ::= @[]
    ai ::= 0
    while (ai < n) {
      push(parts, cg_expr(i, sc, args[ai]))
      ai ::= ai + 1
    }
    "println!(" + join(parts, ", ") + ")"
  }
}


// ─── pat_has_str_lit ──────────────────────────────────────────────────────────
// True if pat is (or contains via Or) a string literal.

pat_has_str_lit := (p: Pat) -> bool {
  match p {
    Pat.Lit(Expr.Str(_)) -> true
    Pat.Lit(_) -> false
    Pat.Or(or_pats) -> {
      n := len(or_pats)
      found ::= false
      i ::= 0
      while (i < n) {
        if (pat_has_str_lit(or_pats[i])) { found ::= true }
        i ::= i + 1
      }
      found
    }
    _ -> false
  }
}


// ─── has_str_pat_in_arms ──────────────────────────────────────────────────────
// True if any arm has a string literal pattern (including inside Or patterns).

has_str_pat_in_arms := (arms: @[MatchArm]) -> bool {
  n := len(arms)
  i ::= 0
  found ::= false
  while (i < n) {
    if (pat_has_str_lit(arms[i].pat)) {
      found ::= true
    }
    i ::= i + 1
  }
  found
}


// ─── cg_arm ───────────────────────────────────────────────────────────────────
// Emit a single match arm.

cg_arm := (i: int, sc: Scope, arm: MatchArm) -> str {
  p := arm.pat
  g_opt := arm.guard
  body := arm.body
  pat_s := cg_pat(p)
  guard_s := match g_opt {
    none -> ""
    Some(g) -> " if " + cg_expr(i, sc, g)
  }
  body_s := cg_struct_val(i + 1, sc, body)
  box_vars := pat_box_var_names(p)
  if (len(box_vars) == 0) {
    "${ind(i + 1)}${pat_s}${guard_s} => ${body_s},"
  } else {
    rebinds ::= @[]
    for nm in box_vars {
      push(rebinds, "let " + nm + " = *" + nm + ";")
    }
    rebind_str := join(rebinds, " ")
    // Concatenate to avoid literal { and } inside a format! string
    "${ind(i + 1)}${pat_s}${guard_s} => " + "{ " + rebind_str + " " + body_s + " }" + ","
  }
}


// ─── cg_expr ──────────────────────────────────────────────────────────────────
// Core expression code generator.  Reads sc but never mutates it.

cg_expr := (i: int, sc: Scope, expr: Expr) -> str {
  e_dispatch := expr
  match e_dispatch {
    Expr.Lambda(_, params, _, _, lam_stmts, fe) -> {
      pn := len(params)
      param_parts ::= @[]
      pi ::= 0
      while (pi < pn) {
        push(param_parts, codegen_param(params[pi]))
        pi ::= pi + 1
      }
      param_str := join(param_parts, ", ")
      inner_sc ::= scope_clone(sc)
      pi2 ::= 0
      while (pi2 < pn) {
        inner_sc ::= scope_insert(inner_sc, params[pi2].name)
        pi2 ::= pi2 + 1
      }
      body_lines ::= cg_body(i + 1, inner_sc, lam_stmts, fe)
      "|" + param_str + "| {\n" + join(body_lines, "\n") + "\n" + ind(i) + "}"
    }
    Expr.Int(n) -> str(n)
    Expr.Float(f) -> str_of(f) + "f32"
    Expr.Bool(b) -> {
      if (b) { "true" } else { "false" }
    }
    Expr.None -> "None"
    Expr.Char(c) -> {
      if (c == '\\') { "'\\\\'" }
      else { if (c == '\'') { "'\\''" }
      else { if (c == '\n') { "'\\n'" }
      else { if (c == '\t') { "'\\t'" }
      else { if (c == '\0') { "'\\0'" }
      else { "'" + str(c) + "'" } } } } }
    }
    Expr.Str(s) -> codegen_string(s)
    Expr.Var(n) -> {
      if (n == "_") {
        "_"
      } else {
        if (n == "str") { "str_of" }
        else {
          if (is_thread_local_var(n)) { n + "_get()" }
          else { n }
        }
      }
    }
    Expr.Field(base_expr, field) -> {
      base := cg_expr(i, sc, base_expr)
      if (is_upper_first(base)) {
        base + "::" + field
      } else {
        base + "." + field
      }
    }
    Expr.Index(idx_base, idx) -> {
      cg_expr(i, sc, idx_base) + ".homun_idx(" + cg_expr(i, sc, idx) + ")"
    }
    Expr.Slice(sl_base, _, _, _) -> {
      base_s := cg_expr(i, sc, sl_base)
      from_opt := expr_slice_from(expr)
      to_opt := expr_slice_to(expr)
      step_opt := expr_slice_step(expr)
      from_s := match from_opt {
        none -> "0"
        Some(e) -> cg_expr(i, sc, e)
      }
      to_s := match to_opt {
        none -> "i64::MAX"
        Some(e) -> cg_expr(i, sc, e)
      }
      step_s := match step_opt {
        none -> "1"
        Some(e) -> cg_expr(i, sc, e)
      }
      "slice!(" + base_s + ", " + from_s + ", " + to_s + ", " + step_s + ")"
    }
    Expr.List(items) -> "vec![" + cg_commas(i, sc, items) + "]"
    Expr.Dict(pairs) -> {
      n := len(pairs)
      parts ::= @[]
      pi ::= 0
      while (pi < n) {
        pk, pv := pairs[pi]
        push(parts, cg_expr(i, sc, pk) + " => " + cg_expr(i, sc, pv))
        pi ::= pi + 1
      }
      "dict![" + join(parts, ", ") + "]"
    }
    Expr.Set(items) -> "set![" + cg_commas(i, sc, items) + "]"
    Expr.Tuple(items) -> "(" + cg_commas(i, sc, items) + ")"
    Expr.Struct(name_opt, fields) -> {
      n := len(fields)
      parts ::= @[]
      fi ::= 0
      while (fi < n) {
        fname, fval := fields[fi]
        push(parts, fname + ": " + cg_struct_val(i, sc, fval))
        fi ::= fi + 1
      }
      match name_opt {
        Some(name) -> name + " { " + join(parts, ", ") + " }"
        none -> {
          val_parts ::= @[]
          vi ::= 0
          while (vi < n) {
            vname, vval := fields[vi]
            push(val_parts, cg_expr(i, sc, vval))
            vi ::= vi + 1
          }
          "(" + join(val_parts, ", ") + ")"
        }
      }
    }
    Expr.BinOp(op, lhs, rhs) -> {
      cg_bin_op(i, sc, op, lhs, rhs)
    }
    Expr.UnOp(op, e) -> {
      match op {
        UnOp.Not -> "!" + cg_expr(i, sc, e)
        UnOp.Neg -> "-" + cg_expr(i, sc, e)
      }
    }
    Expr.Pipe(lhs, rhs) -> {
      match rhs {
        Expr.Call(f, args) -> {
          match f {
            Expr.Var(fn_name) -> {
              if (is_homun_macro(fn_name)) {
                lhs_s := cg_expr(i, sc, lhs)
                if (len(args) == 0) {
                  fn_name + "!(" + lhs_s + ")"
                } else {
                  fn_name + "!(" + lhs_s + ", " + cg_commas(i, sc, args) + ")"
                }
              } else {
                lhs_s := cg_expr(i, sc, lhs)
                all_args ::= @[lhs_s]
                ai ::= 0
                while (ai < len(args)) {
                  all_args ::= all_args + @[cg_expr(i, sc, args[ai])]
                  ai ::= ai + 1
                }
                fn_name + "(" + join(all_args, ", ") + ")"
              }
            }
            _ -> {
              lhs_s := cg_expr(i, sc, lhs)
              all_args ::= @[lhs_s]
              ai ::= 0
              while (ai < len(args)) {
                all_args ::= all_args + @[cg_expr(i, sc, args[ai])]
                ai ::= ai + 1
              }
              cg_expr(i, sc, f) + "(" + join(all_args, ", ") + ")"
            }
          }
        }
        _ -> {
          cg_expr(i, sc, rhs) + "(" + cg_expr(i, sc, lhs) + ")"
        }
      }
    }
    Expr.Call(f, args) -> {
      match f {
        Expr.Var(fname) -> {
          if (fname == "print") {
            cg_print(i, sc, args)
          } else {
            if (is_homun_macro(fname)) {
              fname + "!(" + cg_commas(i, sc, args) + ")"
            } else {
              if (fname == "push" and len(args) == 2) {
                v_s := cg_expr(i, sc, args[0])
                item_s := cg_clone_arg(i, sc, args[1])
                "push(&mut " + v_s + ", " + item_s + ")"
              } else {
                cg_general_call(i, sc, Expr.Var(fname), args)
              }
            }
          }
        }
        _ -> {
          cg_general_call(i, sc, f, args)
        }
      }
    }
    Expr.If(cond, then_stmts, then_fe, _) -> {
      then_lines := cg_body(i + 1, sc, then_stmts, then_fe)
      has_else := expr_if_has_else(expr)
      else_str := if (has_else) {
        else_stmts := expr_if_else_stmts(expr)
        else_fe := expr_if_else_expr(expr)
        else_lines := cg_body(i + 1, sc, else_stmts, else_fe)
        " else {\n" + join(else_lines, "\n") + "\n" + ind(i) + "}"
      } else {
        ""
      }
      "if " + cg_expr(i, sc, cond) + " {\n" + join(then_lines, "\n") + "\n" + ind(i) + "}" + else_str
    }
    Expr.Match(scrut, arms) -> {
      n := len(arms)
      arm_strs ::= @[]
      ai ::= 0
      while (ai < n) {
        push(arm_strs, cg_arm(i, sc, arms[ai]))
        ai ::= ai + 1
      }
      scrut_s := if (has_str_pat_in_arms(arms)) {
        cg_expr(i, sc, scrut) + ".as_str()"
      } else {
        cg_expr(i, sc, scrut)
      }
      "match " + scrut_s + " {\n" + join(arm_strs, "\n") + "\n" + ind(i) + "}"
    }
    Expr.Block(stmts, fe) -> {
      body_lines ::= cg_body(i + 1, sc, stmts, fe)
      "{\n" + join(body_lines, "\n") + "\n" + ind(i) + "}"
    }
    Expr.For(var, iter, body_stmts, _) -> {
      fe_opt := expr_for_final(expr)
      sc0 ::= scope_clone(sc)
      sc0 ::= scope_insert(sc0, var)
      body_sc ::= scope_clone(sc0)
      body_lines, body_sc2 ::= cg_stmts(i + 1, body_sc, body_stmts)
      match fe_opt {
        none -> {}
        Some(fe) -> {
          match fe {
            Expr.Tuple(items) -> {
              if (len(items) > 0) {
                fe2 := Expr.Tuple(items)
                s := cg_expr(i + 1, sc0, fe2)
                push(body_lines, "${ind(i + 1)}${s};")
              }
            }
            _ -> {
              push(body_lines, "${ind(i + 1)}${cg_expr(i + 1, sc0, fe)};")
            }
          }
        }
      }
      "for " + var + " in " + cg_expr(i, sc, iter) + " {\n" + join(body_lines, "\n") + "\n" + ind(i) + "}"
    }
    Expr.While(cond, body_stmts, _) -> {
      fe_opt := expr_while_final(expr)
      body_sc ::= scope_clone(sc)
      body_lines, body_sc2 ::= cg_stmts(i + 1, body_sc, body_stmts)
      match fe_opt {
        none -> {}
        Some(fe) -> {
          fe_sc := scope_clone(sc)
          push(body_lines, "${ind(i + 1)}${cg_expr(i + 1, fe_sc, fe)};")
        }
      }
      "while " + cg_expr(i, sc, cond) + " {\n" + join(body_lines, "\n") + "\n" + ind(i) + "}"
    }
    Expr.Break(_) -> {
      val_opt := expr_break_value(expr)
      match val_opt {
        none -> "break"
        Some(v) -> "return " + cg_expr(i, sc, v)
      }
    }
    Expr.Continue -> "continue"
    Expr.EarlyReturn(val) -> {
      "return " + cg_expr(i, sc, val)
    }
    Expr.TryUnwrap(inner) -> cg_expr(i, sc, inner) + "?"
    Expr.Range(_, _, _) -> {
      start_opt := expr_range_start(expr)
      end_opt := expr_range_end(expr)
      step_opt := expr_range_step(expr)
      match start_opt {
        none -> {
          match end_opt {
            none -> "(0..)"
            Some(e) -> "(0.." + cg_expr(i, sc, e) + ")"
          }
        }
        Some(s) -> {
          match end_opt {
            none -> "(0..)"
            Some(e) -> {
              match step_opt {
                none -> "(" + cg_expr(i, sc, s) + ".." + cg_expr(i, sc, e) + ")"
                Some(st) -> "(" + cg_expr(i, sc, s) + ".." + cg_expr(i, sc, e) + ").step_by(" + cg_expr(i, sc, st) + " as usize)"
              }
            }
          }
        }
      }
    }
  }
}


// ─── cg_stmts ─────────────────────────────────────────────────────────────────
// Process a list of statements.  Returns (lines, modified_scope).
// Scope tracking (adding new bindings) is done here, not in cg_stmt.

cg_stmts := (i: int, sc: Scope, stmts: @[Stmt]) -> (@[str], Scope) {
  n := len(stmts)
  lines ::= @[]
  idx ::= 0
  while (idx < n) {
    s := stmts[idx]
    line := cg_stmt(i, sc, s)
    push(lines, line)
    match s {
      Stmt.Bind(name, _, _)
        | Stmt.BindMut(name, _, _)
        | Stmt.StructDef(name, _, _)
        | Stmt.EnumDef(name, _, _) -> {
        sc ::= scope_insert(sc, name)
      }
      Stmt.BindPat(pat, _) | Stmt.BindPatMut(pat, _) -> {
        names ::= pat_names_list(pat)
        ni ::= 0
        while (ni < len(names)) {
          sc ::= scope_insert(sc, names[ni])
          ni ::= ni + 1
        }
      }
      _ -> {}
    }
    idx ::= idx + 1
  }
  (lines, sc)
}


// ─── cg_body ──────────────────────────────────────────────────────────────────
// Emit body lines (stmts + final expr).  Uses an independent scope copy.

cg_body := (i: int, sc: Scope, stmts: @[Stmt], fe: Expr) -> @[str] {
  body_sc ::= scope_clone(sc)
  lines, body_sc ::= cg_stmts(i, body_sc, stmts)
  fe_s := cg_struct_val(i, body_sc, fe)
  fe_line := "${ind(i)}${fe_s}"
  push(lines, fe_line)
  lines
}


// ─── cg_bind_common ───────────────────────────────────────────────────────────
// Shared body for Stmt.Bind / Stmt.BindMut inside a function body.

cg_bind_common := (i: int, sc: Scope, name: str, e: Expr, mutable: bool) -> str {
  if (is_thread_local_var(name)) {
    => "${ind(i)}${name}_set(${cg_struct_val(i, sc, e)});"
  }
  e_lam := e
  match e_lam {
    Expr.Lambda(_, params, _, _, lam_stmts, fe2) -> {
      param_parts ::= @[]
      for pk in range(len(params)) {
        push(param_parts, codegen_param(params[pk]))
      }
      param_str := join(param_parts, ", ")
      inner_sc ::= scope_clone(sc)
      for pi in range(len(params)) {
        inner_sc ::= scope_insert(inner_sc, params[pi].name)
      }
      body_lines ::= cg_body(i + 1, inner_sc, lam_stmts, fe2)
      => ind(i) + "let " + name + " = |" + param_str + "| {\n" + join(body_lines, "\n") + "\n" + ind(i) + "};"
    }
    _ -> {}
  }
  {
    e_d := e
    rhs := match e_d {
      Expr.Var(n) -> if (scope_contains(sc, n)) { n + ".clone()" } else { cg_expr(i, sc, e) }
      Expr.Field(_, _) -> cg_expr(i, sc, e) + ".clone()"
      Expr.Str(s) -> if (scope_contains(sc, name)) { codegen_string(s) + ".to_string()" } else { cg_expr(i, sc, e) }
      _ -> cg_expr(i, sc, e)
    }
    if (scope_contains(sc, name)) {
      if (is_mut_ref_param(name)) { "${ind(i)}*${name} = ${rhs};" } else { "${ind(i)}${name} = ${rhs};" }
    } else {
      if (mutable) { ind(i) + "let mut " + name + " = " + rhs + ";" }
      else { ind(i) + "let " + name + " = " + rhs + ";" }
    }
  }
}


// ─── cg_stmt ──────────────────────────────────────────────────────────────────
// Emit a single statement.  Mutates sc in place for new bindings.

cg_stmt := (i: int, sc: Scope, stmt: Stmt) -> str {
  match stmt {
    Stmt.Bind(name, e, _) -> {
      cg_bind_common(i, sc, name, e, false)
    }
    Stmt.BindMut(name, e, _) -> {
      cg_bind_common(i, sc, name, e, true)
    }
    Stmt.BindPat(pat, e) -> {
      rhs := cg_expr(i, sc, e)
      names ::= pat_names_list(pat)
      // Check if ALL variable names are already in scope
      all_exist ::= true
      ci ::= 0
      while (ci < len(names)) {
        if (not scope_contains(sc, names[ci])) {
          all_exist ::= false
        }
        ci ::= ci + 1
      }
      if (all_exist and len(names) > 0) {
        // Reassignment: (a, b) = rhs;
        reassign_parts ::= @[]
        ri ::= 0
        while (ri < len(names)) {
          push(reassign_parts, names[ri])
          ri ::= ri + 1
        }
        ind(i) + "(" + join(reassign_parts, ", ") + ") = " + rhs + ";"
      } else {
        // New immutable binding: let (a, b) = rhs;
        bind_str := match pat {
          Pat.Tuple(sub_pats) -> {
            sn := len(sub_pats)
            parts ::= @[]
            si ::= 0
            while (si < sn) {
              sp := sub_pats[si]
              part := match sp {
                Pat.Var(vname) -> vname
                Pat.Wild -> "_"
                _ -> cg_pat(sp)
              }
              push(parts, part)
              si ::= si + 1
            }
            join(parts, ", ")
          }
          Pat.Var(vname) -> vname
          _ -> cg_pat(pat)
        }
        ind(i) + "let (" + bind_str + ") = " + rhs + ";"
      }
    }
    Stmt.BindPatMut(pat, e) -> {
      rhs := cg_expr(i, sc, e)
      names ::= pat_names_list(pat)
      all_exist ::= true
      ci ::= 0
      while (ci < len(names)) {
        if (not scope_contains(sc, names[ci])) {
          all_exist ::= false
        }
        ci ::= ci + 1
      }
      if (all_exist and len(names) > 0) {
        reassign_parts ::= @[]
        ri ::= 0
        while (ri < len(names)) {
          push(reassign_parts, names[ri])
          ri ::= ri + 1
        }
        ind(i) + "(" + join(reassign_parts, ", ") + ") = " + rhs + ";"
      } else {
        bind_str := match pat {
          Pat.Tuple(sub_pats) -> {
            sn := len(sub_pats)
            parts ::= @[]
            si ::= 0
            while (si < sn) {
              sp := sub_pats[si]
              part := match sp {
                Pat.Var(vname) -> "mut " + vname
                Pat.Wild -> "_"
                _ -> cg_pat(sp)
              }
              push(parts, part)
              si ::= si + 1
            }
            join(parts, ", ")
          }
          Pat.Var(vname) -> "mut " + vname
          _ -> cg_pat(pat)
        }
        ind(i) + "let (" + bind_str + ") = " + rhs + ";"
      }
    }
    Stmt.Assign(lhs, rhs) -> {
      rhs_s := match lhs {
        LValue.Field(_, _) -> cg_struct_val(i, sc, rhs)
        _ -> cg_expr(i, sc, rhs)
      }
      "${ind(i)}${cg_lvalue(i, sc, lhs)} = ${rhs_s};"
    }
    Stmt.Use(path) -> {
      ind(i) + "use " + join(path, "::") + ";"
    }
    Stmt.StructDef(name, fields, _) -> {
      n := len(fields)
      field_lines ::= @[]
      fi ::= 0
      while (fi < n) {
        f := fields[fi]
        ty_str := match f.ty {
          none -> "_"
          Some(t) -> codegen_type(t)
        }
        push(field_lines, ind(i + 1) + "pub " + f.name + ": " + ty_str + ",")
        fi ::= fi + 1
      }
      ind(i) + "#[derive(Debug, Clone, PartialEq)]\n" + ind(i) + "struct " + name + " {\n" + join(field_lines, "\n") + "\n" + ind(i) + "}"
    }
    Stmt.EnumDef(name, variants, _) -> {
      register_recursive_type(name)
      n := len(variants)
      var_lines ::= @[]
      vi ::= 0
      while (vi < n) {
        push(var_lines, cg_variant_line(i + 1, variants[vi]))
        vi ::= vi + 1
      }
      clear_recursive_types()
      ind(i) + "#[derive(Debug, Clone, PartialEq)]\n" + ind(i) + "enum " + name + " {\n" + join(var_lines, "\n") + "\n" + ind(i) + "}"
    }
    Stmt.Expression(e) -> {
      "${ind(i)}${cg_expr(i, sc, e)};"
    }
    Stmt.InnerAttr(_) -> ""
    Stmt.ThreadLocal(_, _) -> ""
  }
}


// ─── tl_infer_type ────────────────────────────────────────────────────────────
// Infer the Rust type for a @thread_local initializer expression.

tl_infer_type := (e: Expr) -> str {
  match e {
    Expr.Int(_) -> "i32"
    Expr.Float(_) -> "f32"
    Expr.Bool(_) -> "bool"
    Expr.Str(_) -> "String"
    Expr.List(_) -> "Vec<_>"
    Expr.Dict(_) -> "std::collections::HashMap<_, _>"
    Expr.Set(_) -> "std::collections::HashSet<_>"
    _ -> "i32"
  }
}


// ─── emit_attrs ───────────────────────────────────────────────────────────────
// Emit #[attr] lines for a list of attribute bodies. Empty list emits nothing.

emit_attrs := (attrs: @[str]) -> str {
  parts ::= @[]
  for a in attrs {
    push(parts, "#[" + a + "]")
  }
  if (len(parts) == 0) {
    ""
  } else {
    join(parts, "\n") + "\n"
  }
}


// ─── cg_variant_line ──────────────────────────────────────────────────────────
// Emit one enum variant line at indentation i.

cg_variant_line := (i: int, v: VariantDef) -> str {
  vname := v.name
  vfields := v.fields
  nf := len(vfields)
  if (nf == 0) {
    "${ind(i)}${vname},"
  } else {
    any_named ::= false
    fi_check ::= 0
    while (fi_check < nf) {
      fopt_check, _ := vfields[fi_check]
      match fopt_check {
        Some(_) -> { any_named ::= true }
        none -> {}
      }
      fi_check ::= fi_check + 1
    }
    if (any_named) {
      parts ::= @[]
      fi ::= 0
      while (fi < nf) {
        field_opt, fty := vfields[fi]
        part := match field_opt {
          Some(fname) -> fname + ": " + codegen_type_variant_field(fty)
          none -> "_: " + codegen_type_variant_field(fty)
        }
        push(parts, part)
        fi ::= fi + 1
      }
      // Use concatenation to avoid literal { and } inside a format! string
      "${ind(i)}${vname}" + " { " + join(parts, ", ") + " },"
    } else {
      type_parts ::= @[]
      fi ::= 0
      while (fi < nf) {
        skip, fty := vfields[fi]
        push(type_parts, codegen_type_variant_field(fty))
        fi ::= fi + 1
      }
      "${ind(i)}${vname}(" + join(type_parts, ", ") + "),"
    }
  }
}


// ─── cg_top_fn ────────────────────────────────────────────────────────────────
// Emit a top-level pub fn.

cg_top_fn := (i: int, name: str, explicit_gen: @[str], params: @[Param], ret_ty: Option<TypeExpr>, void_mark: Option<TypeExpr>, stmts: @[Stmt], fe: Expr) -> str {
  pn := len(params)
  param_names ::= @[]
  pk ::= 0
  while (pk < pn) {
    push(param_names, params[pk].name)
    pk ::= pk + 1
  }
  scope0 := scope_from_list(param_names)
  param_str := codegen_params_mut(params)
  register_fn_sig(name, params)
  set_current_mut_ref_params(params)
  generics := if (len(explicit_gen) > 0) { explicit_gen } else { infer_generics(params) }
  gen_str := generics_str(generics)
  ret_str := match void_mark {
    Some(_) -> ""
    none -> {
      match ret_ty {
        none -> ""
        Some(t) -> " -> " + codegen_type(t)
      }
    }
  }
  body_lines ::= cg_body(i + 1, scope0, stmts, fe)
  sig := "pub fn " + name + gen_str + "(" + param_str + ")" + ret_str + " {"
  all_lines ::= @[sig] + body_lines
  push(all_lines, "}")
  join(all_lines, "\n")
}


// ─── infer_const_ty ───────────────────────────────────────────────────────────
// Infer the Rust type annotation for a top-level const binding.

infer_const_ty := (e: Expr) -> str {
  e_ty := e
  match e_ty {
    Expr.Str(_)   -> "&str"
    Expr.Int(_)   -> "i32"
    Expr.Float(_) -> "f32"
    Expr.Bool(_)  -> "bool"
    Expr.Char(_)  -> "char"
    _             -> "_"
  }
}


// ─── cg_top_bind ──────────────────────────────────────────────────────────────
// Shared body for Stmt.Bind / Stmt.BindMut at top level.
// Pass attrs:=@[] for BindMut callers (BindMut carries no attrs).

cg_top_bind := (i: int, name: str, e: Expr, attrs: @[str]) -> str {
  e_top := e
  match e_top {
    Expr.Lambda(explicit_gen, params, ret_ty, void_mark, lam_stmts, fe2) -> {
      fn_str := cg_top_fn(i, name, explicit_gen, params, ret_ty, void_mark, lam_stmts, fe2)
      "" + emit_attrs(attrs) + fn_str
    }
    _ -> {
      ty_str := infer_const_ty(e)
      "pub const " + to_upper(name) + ": " + ty_str + " = " + cg_expr(0, scope_new(), e) + ";"
    }
  }
}


// ─── codegen_top_level_stmt ───────────────────────────────────────────────────
// Emit a top-level statement.

codegen_top_level_stmt := (i: int, stmt: Stmt, rs_content: RsContent) -> str {
  match stmt {
    Stmt.Use(path) -> {
      if (len(path) == 1) {
        content_opt := rs_content_get(rs_content, path[0])
        match content_opt {
          none -> "use " + join(path, "::") + ";"
          Some(content) -> "// ── use " + path[0] + " ──\n" + content
        }
      } else {
        "use " + join(path, "::") + ";"
      }
    }
    Stmt.StructDef(name, fields, attrs) -> {
      n := len(fields)
      field_lines ::= @[]
      fi ::= 0
      while (fi < n) {
        f := fields[fi]
        ty_str := match f.ty {
          none -> "_"
          Some(t) -> codegen_type(t)
        }
        push(field_lines, ind(i + 1) + "pub " + f.name + ": " + ty_str + ",")
        fi ::= fi + 1
      }
      attrs_str := emit_attrs(attrs)
      has_derive ::= false
      for a in attrs {
        if (contains(a, "derive(")) { has_derive ::= true }
      }
      body := name + " {\n" + join(field_lines, "\n") + "\n}"
      if (has_derive) {
        attrs_str + "pub struct " + body
      } else {
        attrs_str + "#[derive(Debug, Clone, PartialEq)]\npub struct " + body
      }
    }
    Stmt.EnumDef(name, variants, attrs) -> {
      register_recursive_type(name)
      n := len(variants)
      var_lines ::= @[]
      vi ::= 0
      while (vi < n) {
        push(var_lines, cg_variant_line(i + 1, variants[vi]))
        vi ::= vi + 1
      }
      clear_recursive_types()
      attrs_str := emit_attrs(attrs)
      has_derive ::= false
      for a in attrs {
        if (contains(a, "derive(")) { has_derive ::= true }
      }
      body := name + " {\n" + join(var_lines, "\n") + "\n}"
      if (has_derive) {
        attrs_str + "pub enum " + body
      } else {
        attrs_str + "#[derive(Debug, Clone, PartialEq)]\npub enum " + body
      }
    }
    Stmt.Bind(name, e, attrs) -> {
      cg_top_bind(i, name, e, attrs)
    }
    Stmt.BindMut(name, e, attrs) -> {
      cg_top_bind(i, name, e, attrs)
    }
    Stmt.BindPatMut(_, _) -> ""
    Stmt.BindPat(_, _) -> ""
    Stmt.Assign(_, _) -> ""
    Stmt.Expression(e) -> cg_expr(0, scope_new(), e) + ";"
    Stmt.ThreadLocal(tl_name, tl_e) -> {
      upper := to_upper(tl_name)
      ty_str := tl_infer_type(tl_e)
      init_str := cg_struct_val(0, scope_new(), tl_e)
      register_thread_local_var(tl_name)
      tl_lines ::= @[]
      push(tl_lines, "thread_local! {")
      push(tl_lines, "    static " + upper + ": std::cell::RefCell<" + ty_str + "> = std::cell::RefCell::new(" + init_str + ");")
      push(tl_lines, "}")
      push(tl_lines, "pub fn " + tl_name + "_get() -> " + ty_str + " { " + upper + ".with(|v| v.borrow().clone()) }")
      push(tl_lines, "pub fn " + tl_name + "_set(val: " + ty_str + ") { " + upper + ".with(|v| *v.borrow_mut() = val); }")
      join(tl_lines, "\n")
    }
    Stmt.InnerAttr(_) -> ""
  }
}


// ─── codegen_program_with_resolved ────────────────────────────────────────────
// Public API: emit Rust source for the entire program.
// Skips use statements for .hom files that were resolved and inlined.

codegen_program_with_resolved := (prog: @[Stmt], hom_files: HomFiles, rs_content: RsContent) -> str {
  n := len(prog)
  clear_thread_local_vars()
  // Pre-pass: register variant field types for all top-level enums so that
  // cg_arm can detect bindings landing on Box<T> positions. The registry is
  // additive across files so that when this codegen pass runs for a file that
  // imports an enum via `use`, the dependency's variants (registered when its
  // own earlier DFS-ordered codegen pass ran) are still visible.
  jj ::= 0
  while (jj < n) {
    match prog[jj] {
      Stmt.EnumDef(ename, variants, _) -> {
        nv := len(variants)
        vi ::= 0
        while (vi < nv) {
          v := variants[vi]
          vfields := v.fields
          field_tys ::= @[]
          fi ::= 0
          nf := len(vfields)
          while (fi < nf) {
            fname_opt, fty := vfields[fi]
            push(field_tys, fty)
            fi ::= fi + 1
          }
          qual := "${ename}.${v.name}"
          register_variant_field_types(qual, field_tys)
          vi ::= vi + 1
        }
      }
      _ -> {}
    }
    jj ::= jj + 1
  }
  // Pass 1: collect InnerAttr stmts and emit as #![..] at top
  inner_lines ::= @[]
  j ::= 0
  while (j < n) {
    s := prog[j]
    match s {
      Stmt.InnerAttr(body) -> {
        push(inner_lines, "#![" + body + "]")
      }
      _ -> {}
    }
    j ::= j + 1
  }
  header := if (len(inner_lines) == 0) {
    ""
  } else {
    join(inner_lines, "\n") + "\n"
  }
  // Pass 2: emit non-InnerAttr statements
  i ::= 0
  parts ::= @[]
  while (i < n) {
    s := prog[i]
    skip := match s {
      Stmt.InnerAttr(_) -> true
      Stmt.Use(path) -> len(path) == 1 and hom_files_contains(hom_files, path[0])
      _ -> false
    }
    if (not skip) {
      push(parts, codegen_top_level_stmt(0, prog[i], rs_content))
    }
    i ::= i + 1
  }
  body := join(parts, "\n")
  "${header}${body}"
}
