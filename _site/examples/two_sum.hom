// ─── examples/two_sum.hom ───────────────────────────────────────
// Demonstrates: hash map (dict), membership (in), dict_insert, early return.
// O(n) one-pass: remember each value's index, return as soon as the
// complement has been seen.
use std
use dict

two_sum := (nums: @[int], target: int) -> @[int] {
  seen ::= @{}                       // value -> index
  for i in range(len(nums)) {
    comp := target - nums[i]
    if (comp in seen) { => @[seen[comp], i] }
    dict_insert(seen, nums[i], i)
  }
  @[]
}

main := () -> _ {
  print("Two Sum: {:?}", two_sum(@[2, 7, 11, 15], 9))
  print("Two Sum: {:?}", two_sum(@[3, 2, 4], 6))
}
